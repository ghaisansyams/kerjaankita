# ---------------------------------------------------------------------------
# FlowDesk environment
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings → API). Restart `npm run dev` after editing.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role key — SERVER ONLY. Never expose to the client.
# Used for privileged admin actions (inviting users, first-run setup).
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app (used for auth email redirect links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI Document Import (optional). Pick the vendor with AI_PROVIDER; leave unset
# to auto-use whichever provider has a key. NEVER commit real API keys.
# ---------------------------------------------------------------------------
# AI_PROVIDER=openai-compatible          # or: anthropic

# OpenAI-compatible endpoint (any Chat Completions API):
# OPENAI_COMPATIBLE_BASE_URL=https://ai.hajid.dev/v1
# OPENAI_COMPATIBLE_MODEL=ocg/glm-5.2
# OPENAI_COMPATIBLE_API_KEY=             # SERVER ONLY — read from env, never hardcode

# Anthropic (alternative provider):
# ANTHROPIC_API_KEY=
# ANTHROPIC_IMPORT_MODEL=claude-sonnet-5
