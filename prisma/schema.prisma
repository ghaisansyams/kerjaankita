  deletedBy  String?   @map("deleted_by") @db.Uuid

  // Auth — password stored here (migrated from Supabase auth.users)
  passwordHash String? @map("password_hash")

  // Self-references for audit
  createdByProfile Profile?  @relation("ProfileCreatedBy", fields: [createdBy], references: [id])
  updatedByProfile Profile?  @relation("ProfileUpdatedBy", fields: [updatedBy], references: [id])
  deletedByProfile Profile?  @relation("ProfileDeletedBy", fields: [deletedBy], references: [id])
  profilesCreated  Profile[] @relation("ProfileCreatedBy")
  profilesUpdated  Profile[] @relation("ProfileUpdatedBy")
  profilesDeleted  Profile[] @relation("ProfileDeletedBy")

  // Relations
  organizationMembers OrganizationMember[]
  workspaceMembers    WorkspaceMember[]
  teamMembers         TeamMember[]
  projectMembers      ProjectMember[]
  ownedProjects       Project[]                @relation("ProjectOwner")
  assignedTasks       Task[]                   @relation("TaskAssignee")
  reportedTasks       Task[]                   @relation("TaskReporter")
  comments            Comment[]                @relation("CommentAuthor")
  activities          Activity[]               @relation("ActivityActor")
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  contacts            Contact[]                @relation("ContactUser")
  momPic              Mom[]                    @relation("MomPic")
  momPreparedBy       Mom[]                    @relation("MomPreparedBy")
  meetingRecords      MeetingRecord[]
  importJobsCreated   ImportJob[]

  @@map("profiles")
}

