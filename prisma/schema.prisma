// ---------------------------------------------------------------------------
// Profiles — 1:1 with auth users
// ---------------------------------------------------------------------------
model Profile {
  id         String    @id @db.Uuid
  email      String?
  fullName   String?   @map("full_name")
  avatarUrl  String?   @map("avatar_url")
  title      String?
  phone      String?
  timezone   String    @default("UTC")
