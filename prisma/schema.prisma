  project      Project?              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, entityId])
  @@map("custom_field_values")
}

// ---------------------------------------------------------------------------
// Automation
// ---------------------------------------------------------------------------
model AutomationRule {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  workspaceId    String?   @map("workspace_id") @db.Uuid
  projectId      String?   @map("project_id") @db.Uuid
  name           String
  description    String?
  triggerType    String    @map("trigger_type")
  triggerConfig  Json      @default("{}") @map("trigger_config")
  conditions     Json      @default("[]")
  actions        Json      @default("[]")
  isActive       Boolean   @default(true) @map("is_active")
  runCount       Int       @default(0) @map("run_count")
  lastRunAt      DateTime? @map("last_run_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy      String?   @map("deleted_by") @db.Uuid

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs         AutomationRun[]

  @@map("automation_rules")
}

model AutomationRun {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  ruleId         String              @map("rule_id") @db.Uuid
  entity         EntityType?
  entityId       String?             @map("entity_id") @db.Uuid
  status         AutomationRunStatus
  errorMessage   String?             @map("error_message")
  payload        Json                @default("{}")
  durationMs     Int?                @map("duration_ms")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule         AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@map("automation_runs")
}

// ---------------------------------------------------------------------------
// MOM (Minutes of Meeting)
// ---------------------------------------------------------------------------
model Mom {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  workspaceId    String?   @map("workspace_id") @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  title          String
  meetingDate    DateTime  @map("meeting_date") @db.Date
  meetingTime    String?   @map("meeting_time")
  location       String?
  picId          String?   @map("pic_id") @db.Uuid
  preparedBy     String?   @map("prepared_by") @db.Uuid
  approvedByName String    @default("Galih Aldio Putra") @map("approved_by_name")
  approvedByRole String    @default("Director") @map("approved_by_role")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy      String?   @map("deleted_by") @db.Uuid

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pic          Profile?          @relation("MomPic", fields: [picId], references: [id], onDelete: SetNull)
  preparer     Profile?          @relation("MomPreparedBy", fields: [preparedBy], references: [id], onDelete: SetNull)
  participants MomParticipant[]
  distribution MomDistribution[]
  notes        MomNote[]

  @@map("mom")
}

model MomParticipant {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  momId    String  @map("mom_id") @db.Uuid
  name     String
  role     String?
  company  String?
  position Int     @default(0)

  mom Mom @relation(fields: [momId], references: [id], onDelete: Cascade)

  @@map("mom_participants")
}

model MomDistribution {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  momId     String @map("mom_id") @db.Uuid
  recipient String
  position  Int    @default(0)

  mom Mom @relation(fields: [momId], references: [id], onDelete: Cascade)

  @@map("mom_distribution")
}

model MomNote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  momId     String   @map("mom_id") @db.Uuid
  category  String   @default("discussion")
  content   String
  position  Int      @default(0)
  taskId    String?  @map("task_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  mom  Mom   @relation(fields: [momId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@map("mom_notes")
}

// ---------------------------------------------------------------------------
// AI Import (Roadmaps, Modules, Import Jobs)
// ---------------------------------------------------------------------------
model Roadmap {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  name           String
  description    String?
  color          String?
  position       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy      String?   @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  modules      Module[]
  tasks        Task[]

  @@map("roadmaps")
}

model Module {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  roadmapId      String?   @map("roadmap_id") @db.Uuid
  name           String
  description    String?
  position       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy      String?   @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roadmap      Roadmap?     @relation(fields: [roadmapId], references: [id], onDelete: SetNull)
  tasks        Task[]

  @@map("modules")
}

model ImportJob {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String?  @map("project_id") @db.Uuid
  createdBy      String?  @map("created_by") @db.Uuid
  fileName       String   @map("file_name")
  filePath       String?  @map("file_path")
  fileType       String?  @map("file_type")
  documentType   String?  @map("document_type")
  provider       String?
  status         String   @default("pending")
  error          String?
  result         Json?
  confidence     String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator      Profile?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)], map: "idx_import_jobs_org")
  @@map("import_jobs")
}

// ---------------------------------------------------------------------------
// Meeting Assistant
// ---------------------------------------------------------------------------
model MeetingRecord {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  workspaceId     String?   @map("workspace_id") @db.Uuid
  projectId       String?   @map("project_id") @db.Uuid
  title           String
  description     String?
  meetingDate     DateTime? @map("meeting_date") @db.Date
  meetingTime     String?   @map("meeting_time")
  location        String?
  meetingType     String?   @map("meeting_type")
  audioBucket     String    @default("meeting-recordings") @map("audio_bucket")
  audioPath       String?   @map("audio_path")
  audioFileName   String?   @map("audio_file_name")
  audioMimeType   String?   @map("audio_mime_type")
  audioSizeBytes  BigInt?   @map("audio_size_bytes")
  durationSeconds Int?      @map("duration_seconds")
  status          String    @default("uploaded")
  error           String?
  isPrivate       Boolean   @default(false) @map("is_private")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy       String?   @map("created_by") @db.Uuid
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy       String?   @map("updated_by") @db.Uuid
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy       String?   @map("deleted_by") @db.Uuid

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  project      Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator      Profile?            @relation(fields: [createdBy], references: [id])
  transcripts  MeetingTranscript[]
  summaries    MeetingSummary[]
  actionItems  MeetingActionItem[]

  @@map("meeting_records")
}

model MeetingTranscript {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  meetingId      String   @map("meeting_id") @db.Uuid
  content        String   @default("")
  rawContent     String?  @map("raw_content")
  provider       String?
  model          String?
  language       String?
  segments       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String?  @map("updated_by") @db.Uuid

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting      MeetingRecord @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId])
  @@map("meeting_transcripts")
}

model MeetingSummary {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  meetingId        String   @map("meeting_id") @db.Uuid
  objective        String?
  discussion       String?
  decisions        Json?
  risks            Json?
  pendingQuestions Json?    @map("pending_questions")
  conclusion       String?
  raw              Json?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting      MeetingRecord @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId])
  @@map("meeting_summaries")
}

model MeetingActionItem {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  meetingId      String    @map("meeting_id") @db.Uuid
  task           String
  responsible    String?
  priority       String?
  deadline       DateTime? @db.Date
  status         String    @default("open")
  taskId         String?   @map("task_id") @db.Uuid
  position       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting      MeetingRecord @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  linkedTask   Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@map("meeting_action_items")
}
